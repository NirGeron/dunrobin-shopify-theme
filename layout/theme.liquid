<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta name="google-site-verification" content="zsHhrKhdl-rDowwYGmDEXpLj6lzVbNZhAfaUwuNgKrk" />
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_brand }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      Search results and empty collections are crawlable (robots.txt allows
      them) but have nothing to rank: results change with every query, and an
      empty collection is a heading and a "no products" line. Left indexable
      they pile up as "Crawled - currently not indexed". noindex lifts itself
      once a collection has products. follow keeps their links counted.

      The 404 page's canonical is /404, but Shopify adds that itself even when
      the theme leaves the tag out, so there is nothing to do about it here.
    {%- endcomment -%}
    {%- liquid
      assign noindex = false
      if template.name == 'search'
        assign noindex = true
      elsif template.name == 'collection' and collection.products_count == 0
        assign noindex = true
      endif
    -%}
    {%- if noindex -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon-192.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    {%- comment -%}
      A blog's page_title is the blog's name in Shopify, which for the default
      blog is "News". This page lists blog posts, so it takes its title from the
      locale file instead.
    {%- endcomment -%}
    {%- liquid
      assign document_title = page_title
      if template.name == 'blog'
        assign document_title = 'blogs.general.title' | t
      endif
    -%}
    <title>
      {{ document_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless document_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- comment -%}
      A description set under Search engine listing in the admin always wins and
      is used as written. When one is missing, Google fills the snippet with
      whatever text it likes, so each template derives one from its own content
      instead (cut to 155 characters, the most a result shows on desktop), then
      from the shop's home description. Stripping tags would glue one paragraph
      to the next, so a space goes in after each block first, and splitting on
      a single space (which also splits on newlines and drops repeats) tidies
      the whitespace. escape_once leaves entities such as &amp; from the rich
      text editor alone instead of escaping them twice.
    {%- endcomment -%}
    {%- liquid
      assign meta_description = page_description
      if meta_description == blank
        case template.name
          when 'product'
            assign meta_description = product.description
          when 'collection'
            assign meta_description = collection.description
            if meta_description == blank and collection.handle == 'all'
              assign meta_description = 'collections.general.meta_description_all' | t
            endif
          when 'article'
            assign meta_description = article.excerpt_or_content
          when 'blog'
            assign meta_description = 'blogs.general.meta_description' | t
          when 'page'
            assign meta_description = page.content
            if meta_description == blank and page.template_suffix == 'about'
              assign meta_description = 'pages.about.meta_description' | t
            elsif meta_description == blank and page.template_suffix == 'visit'
              assign meta_description = 'pages.visit.meta_description' | t
            endif
        endcase
        if meta_description == blank
          assign meta_description = shop.description
        endif
        assign meta_description = meta_description | replace: '</p>', '</p> ' | replace: '</li>', '</li> ' | replace: '</h2>', '</h2> ' | replace: '</h3>', '</h3> ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' '
        assign meta_description = meta_description | strip_html | split: ' ' | join: ' ' | truncate: 155
      endif
    -%}
    {%- if meta_description != blank -%}
      <meta name="description" content="{{ meta_description | escape_once }}">
    {%- endif -%}

    {% render 'search-console' %}
    {% render 'meta-tags', description: meta_description %}
    {% render 'structured-data' %}

    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {{ content_for_header }}

    {%- comment -%}
      A font_picker can return nil — the saved handle may predate this theme, or
      the chosen family may not carry the bold or italic variant. font_face errors
      on anything that is not a font drop, so every call is guarded and the CSS
      falls back to a literal stack when the drop is missing.
    {%- endcomment -%}
    {%- liquid
      assign heading_font = settings.font_heading
      assign body_font = settings.font_body

      if heading_font.family
        assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
      endif

      if body_font.family
        assign body_font_bold = body_font | font_modify: 'weight', 'bold'
        assign body_font_italic = body_font | font_modify: 'style', 'italic'
      endif

      assign fallback_stack = "'Libre Baskerville', Georgia, 'Times New Roman', serif"
    -%}

    {%- if heading_font.family -%}
      {{ heading_font | font_face: font_display: 'swap' }}
      {%- if heading_font_bold.family -%}
        {{ heading_font_bold | font_face: font_display: 'swap' }}
      {%- endif -%}
    {%- endif -%}

    {%- if body_font.family -%}
      {{ body_font | font_face: font_display: 'swap' }}
      {%- if body_font_bold.family -%}
        {{ body_font_bold | font_face: font_display: 'swap' }}
      {%- endif -%}
      {%- if body_font_italic.family -%}
        {{ body_font_italic | font_face: font_display: 'swap' }}
      {%- endif -%}
    {%- endif -%}

    {%- unless heading_font.family and body_font.family -%}
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      >
    {%- endunless -%}

    <style data-shopify>
      :root {
        --brand: {{ settings.color_brand }};
        --brand-dark: {{ settings.color_brand_dark }};
        --brand-rgb: {{ settings.color_brand.red }}, {{ settings.color_brand.green }}, {{ settings.color_brand.blue }};
        --accent: {{ settings.color_accent }};
        --bg: {{ settings.color_background }};
        --bg-alt: {{ settings.color_background_alt }};
        --text: {{ settings.color_text }};
        --text-muted: {{ settings.color_text_muted }};
        --border: {{ settings.color_border }};
        --button-text: {{ settings.color_button_text }};
        --button-radius: {{ settings.button_radius }}px;

        --font-heading: {% if heading_font.family %}{{ heading_font.family }}, {{ heading_font.fallback_families }}{% else %}{{ fallback_stack }}{% endif %};
        --font-heading-weight: {{ heading_font.weight | default: 400 }};
        --font-heading-style: {{ heading_font.style | default: 'normal' }};
        --font-heading-transform: {{ settings.font_heading_transform | default: 'none' }};
        --font-body: {% if body_font.family %}{{ body_font.family }}, {{ body_font.fallback_families }}{% else %}{{ fallback_stack }}{% endif %};
        --font-body-weight: {{ body_font.weight | default: 400 }};
        --font-body-style: {{ body_font.style | default: 'normal' }};

        --heading-scale: {{ settings.font_heading_scale | divided_by: 100.0 }};
        --body-scale: {{ settings.font_body_scale | divided_by: 100.0 }};
        --label-tracking: {{ settings.label_letter_spacing | divided_by: 100.0 }}em;

        --page-width: {{ settings.page_width }}px;
        --section-gap: {{ settings.spacing_sections }}px;
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };
      window.themeStrings = {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }}
      };
    </script>

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template--{{ request.page_type | handle }} cart-type--{{ settings.cart_type }}">
    <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% render 'cart-drawer' %}
    {%- endif -%}

    {%- if settings.age_gate_enabled -%}
      {% render 'age-gate' %}
    {%- endif -%}

    {%- if settings.xmas_popup_enabled -%}
      {% render 'christmas-popup' %}
    {%- endif -%}

    {% render 'whatsapp-button' %}
    {% render 'shop-now-button' %}
    {% render 'back-to-top' %}

    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>
  </body>
</html>
