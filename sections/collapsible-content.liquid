<div
  class="scheme--{{ section.settings.color_scheme }} section-padding"
  style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px"
>
  <div class="page-width">
    <div class="{% if section.settings.narrow %}page-width--narrow{% endif %}" style="margin-inline:auto">
      {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
        <div class="section-header section-header--{{ section.settings.heading_alignment }}">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="accordion">
        {%- for block in section.blocks -%}
          <details class="accordion__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="accordion__summary">
              {{ block.settings.heading }}
              <span class="accordion__icon"></span>
            </summary>
            <div class="accordion__content rte">
              {{ block.settings.content }}
              {%- if block.settings.page != blank -%}
                {{ block.settings.page.content }}
              {%- endif -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collapsible content",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "narrow", "label": "Constrain width", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Off-white" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery and shipping" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Shipping is calculated at checkout. All orders require an adult signature on delivery.</p>"
        },
        { "type": "page", "id": "page", "label": "Or pull content from a page" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible content",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
