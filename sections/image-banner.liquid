{%- liquid
  comment
    "Whole image" shows the picture at full width and trims a slice off the top
    and bottom. The box is given the image's own ratio divided by how much of
    its height survives the trim, so object-fit: cover crops exactly that much
    and nothing is lost off the sides.

    The top and bottom are trimmed separately because the subject is not
    centred: the castle's spire tips sit close to the top of the picture while
    the formal garden below it can go. object-position hands the crop back in
    the same proportion, so the slice comes off where it was asked to.

    On a phone the bottom trim is halved. The box is only as tall as the screen
    is wide, so a full-strength trim would leave a thin strip with the seal
    covering most of it.
  endcomment
  assign banner_style = ''

  if section.settings.height == 'fit'
    if section.settings.image != blank
      assign source_ratio = section.settings.image.aspect_ratio
    else
      assign source_ratio = 1.4532
    endif

    assign trim_top = section.settings.trim_top | times: 1.0
    assign trim_bottom = section.settings.trim_bottom | times: 1.0
    assign trim_bottom_phone = trim_bottom | divided_by: 2.0

    assign visible = 100.0 | minus: trim_top | minus: trim_bottom
    assign banner_ratio = source_ratio | times: 100.0 | divided_by: visible
    assign trimmed = trim_top | plus: trim_bottom
    assign focus_y = 50.0
    if trimmed > 0
      assign focus_y = trim_top | times: 100.0 | divided_by: trimmed
    endif

    assign visible_phone = 100.0 | minus: trim_top | minus: trim_bottom_phone
    assign banner_ratio_phone = source_ratio | times: 100.0 | divided_by: visible_phone
    assign trimmed_phone = trim_top | plus: trim_bottom_phone
    assign focus_y_phone = 50.0
    if trimmed_phone > 0
      assign focus_y_phone = trim_top | times: 100.0 | divided_by: trimmed_phone
    endif

    assign banner_style = '--banner-ratio:' | append: banner_ratio
    assign banner_style = banner_style | append: ';--banner-focus-y:' | append: focus_y | append: '%'
    assign banner_style = banner_style | append: ';--banner-ratio-phone:' | append: banner_ratio_phone
    assign banner_style = banner_style | append: ';--banner-focus-y-phone:' | append: focus_y_phone | append: '%'
  endif
-%}

<div
  class="image-banner image-banner--{{ section.settings.height }} {% if section.settings.fit_mobile %}image-banner--fit-mobile{% endif %}"
  {% if banner_style != '' %}style="{{ banner_style }}"{% endif %}
>
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2400 }}"
      srcset="
        {{ section.settings.image | image_url: width: 900 }} 900w,
        {{ section.settings.image | image_url: width: 1400 }} 1400w,
        {{ section.settings.image | image_url: width: 2000 }} 2000w,
        {{ section.settings.image | image_url: width: 2800 }} 2800w
      "
      sizes="100vw"
      alt="{{ section.settings.image.alt | escape }}"
      width="{{ section.settings.image.width }}"
      height="{{ section.settings.image.height }}"
      loading="lazy"
    >
  {%- else -%}
    <img src="{{ 'castle-duotone.jpg' | asset_url }}" alt="" width="1600" height="1101" loading="lazy">
  {%- endif -%}

  {%- if section.settings.show_seal -%}
    <div class="image-banner__seal" style="--seal-size: {{ section.settings.seal_size }}%">
      {%- if section.settings.seal_image != blank -%}
        <img
          src="{{ section.settings.seal_image | image_url: width: 1200 }}"
          alt="{{ section.settings.seal_image.alt | escape }}"
          width="{{ section.settings.seal_image.width }}"
          height="{{ section.settings.seal_image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <img src="{{ 'seal-sans-peur.png' | asset_url }}" alt="" width="635" height="635" loading="lazy">
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.caption != blank -%}
    <div class="image-banner__caption">
      <p class="eyebrow eyebrow--light">{{ section.settings.caption }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Image banner",
  "tag": "section",
  "class": "shopify-section--full-bleed",
  "settings": [
    {
      "type": "paragraph",
      "content": "A full-width image used to break up the page — the copper stills, the coastline, the castle."
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "fit", "label": "Whole image, trimmed top and bottom" },
        { "value": "auto", "label": "Full image height" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "trim_top",
      "label": "Trim off the top",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "%",
      "default": 5,
      "info": "Only used by the \"Whole image\" height. Keep it small if there is a spire or roofline near the top."
    },
    {
      "type": "range",
      "id": "trim_bottom",
      "label": "Trim off the bottom",
      "min": 0,
      "max": 45,
      "step": 1,
      "unit": "%",
      "default": 36,
      "info": "Only used by the \"Whole image\" height. The larger the trim, the shorter the banner. Phones use half of it."
    },
    {
      "type": "checkbox",
      "id": "fit_mobile",
      "label": "Show the whole image on mobile",
      "default": true,
      "info": "Uncropped on phones, so nothing is lost off the sides."
    },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "header", "content": "Seal" },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Show a seal over the image",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "seal_image",
      "label": "Seal",
      "info": "Leave empty to use the white Sans Peur seal."
    },
    {
      "type": "range",
      "id": "seal_size",
      "label": "Seal size",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "%",
      "default": 30
    }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
