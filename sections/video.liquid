<div
  class="scheme--{{ section.settings.color_scheme }} section-padding"
  style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px"
>
  <div class="{% if section.settings.full_width %}page-width--full{% else %}page-width{% endif %}">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header section-header--center {% if section.settings.full_width %}page-width{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="media media--wide">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1600x',
            autoplay: section.settings.autoplay,
            loop: section.settings.loop,
            muted: section.settings.autoplay,
            controls: true
        }}
      {%- elsif section.settings.video_url != blank -%}
        <iframe
          src="{{ section.settings.video_url }}"
          title="{{ section.settings.heading | escape }}"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="width:100%;height:100%;border:0;position:absolute;inset:0"
        ></iframe>
      {%- else -%}
        <img src="{{ 'cocktail.jpg' | asset_url }}" alt="" width="1600" height="900" loading="lazy">
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "video", "id": "video", "label": "Video", "info": "Uploaded to your Shopify files." },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or a YouTube / Vimeo URL",
      "accept": ["youtube", "vimeo"]
    },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay (muted)", "default": false },
    { "type": "checkbox", "id": "loop", "label": "Loop", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Off-white" },
        { "value": "brand", "label": "Brand navy" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [{ "name": "Video" }]
}
{% endschema %}
