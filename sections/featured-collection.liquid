<div
  class="scheme--{{ section.settings.color_scheme }} section-padding"
  style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px"
>
  <div class="page-width">
    <div class="section-header section-header--{{ section.settings.heading_alignment }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="section-header__text rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
      {%- liquid
        assign products = section.settings.collection.products
        assign count = section.settings.products_to_show
      -%}

      {%- if products.size > 0 -%}
        {%- for product in products limit: count -%}
          <li>{% render 'card-product', product: product, ratio: section.settings.image_ratio %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..count) -%}
          <li>{% render 'card-product', product: blank, ratio: section.settings.image_ratio %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div style="text-align:center;margin-top:4.8rem">
        <a href="{{ section.settings.collection.url }}" class="button button--secondary">
          {{ 'sections.featured_collection.view_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our spirits" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' button", "default": true },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Off-white" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
