<div class="page-width section-padding" style="--padding-top:64px;--padding-bottom:96px">
  <div class="collection-hero">
    <h1 class="h1">{{ section.settings.heading | default: page_title }}</h1>
  </div>

  <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
    {%- liquid
      if section.settings.sort == 'products_high'
        assign collections_list = collections | sort: 'all_products_count' | reverse
      elsif section.settings.sort == 'alphabetical'
        assign collections_list = collections | sort: 'title'
      else
        assign collections_list = collections
      endif
    -%}
    {%- for list_collection in collections_list -%}
      <li>
        <div class="card card--center">
          <a href="{{ list_collection.url }}" class="card__media media media--{{ section.settings.image_ratio }}" tabindex="-1" aria-hidden="true">
            {%- if list_collection.featured_image -%}
              <img
                src="{{ list_collection.featured_image | image_url: width: 900 }}"
                srcset="{{ list_collection.featured_image | image_url: width: 450 }} 450w, {{ list_collection.featured_image | image_url: width: 900 }} 900w"
                sizes="(min-width: 750px) 33vw, 100vw"
                alt="{{ list_collection.featured_image.alt | escape }}"
                width="{{ list_collection.featured_image.width }}"
                height="{{ list_collection.featured_image.height }}"
                loading="lazy"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </a>
          <h2 class="card__title"><a href="{{ list_collection.url }}">{{ list_collection.title }}</a></h2>
          <div class="card__price">{{ 'collections.general.items_count' | t: count: list_collection.all_products_count }}</div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 3 },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort collections by",
      "options": [
        { "value": "default", "label": "Store order" },
        { "value": "alphabetical", "label": "A–Z" },
        { "value": "products_high", "label": "Most products" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "portrait"
    }
  ]
}
{% endschema %}
