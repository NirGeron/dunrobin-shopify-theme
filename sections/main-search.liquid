{%- paginate search.results by 12 -%}
  <div class="page-width section-padding" style="--padding-top:64px;--padding-bottom:96px">
    <div class="collection-hero">
      <h1 class="h1">{{ 'general.search.title' | t }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" style="max-width:52rem;margin:3.2rem auto 0">
        <div class="field">
          <label class="visually-hidden" for="SearchInput">{{ 'general.search.placeholder' | t }}</label>
          <input
            class="field__input"
            type="search"
            id="SearchInput"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
          >
        </div>
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="collection-toolbar__count" style="margin-bottom:3.2rem">
          {{ 'general.search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>
        <ul class="product-grid product-grid--3" role="list">
          {%- for item in search.results -%}
            <li>
              {%- if item.object_type == 'product' -%}
                {% render 'card-product', product: item %}
              {%- elsif item.object_type == 'article' -%}
                {% render 'card-article', article: item %}
              {%- else -%}
                <div class="card">
                  <h3 class="card__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="cart-empty">
          <p class="h4">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{ "name": "Search results", "tag": "section", "settings": [] }
{% endschema %}
