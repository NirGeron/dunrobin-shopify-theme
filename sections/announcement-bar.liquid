{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar"
    style="background-color: {{ section.settings.background }}; color: {{ section.settings.text_color }}"
  >
    <announcement-bar data-autorotate="{{ section.settings.autorotate }}" data-speed="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        <div
          class="announcement-bar__inner"
          data-announcement
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </announcement-bar>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "shopify-section-announcement",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#1C348F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "autorotate",
      "label": "Rotate between announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per announcement",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Handcrafted in Golspie, in the Scottish Highlands"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": { "text": "Handcrafted in Golspie, in the Scottish Highlands" }
      }
    ]
  },
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
