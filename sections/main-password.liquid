<div class="hero hero--full hero--center">
  <div class="hero__media">
    <img
      src="{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 }}{% else %}{{ 'castle-duotone.jpg' | asset_url }}{% endif %}"
      alt=""
      width="1600"
      height="1101"
      fetchpriority="high"
    >
    <div class="hero__overlay" style="opacity:.6"></div>
  </div>

  <div class="hero__content">
    <div class="page-width">
      <div class="hero__inner">
        <img
          class="hero__logo"
          src="{% if settings.logo_light != blank %}{{ settings.logo_light | image_url: width: 800 }}{% else %}{{ 'logo-white.png' | asset_url }}{% endif %}"
          alt="{{ shop.name | escape }}"
          width="800"
          height="242"
        >

        {%- if section.settings.heading != blank -%}
          <h1 class="hero__heading h1">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="hero__text rte">{{ section.settings.text }}</div>
        {%- endif -%}

        <div style="max-width:36rem;margin:3.2rem auto 0">
          {%- form 'storefront_password' -%}
            {%- if form.errors -%}
              <p class="form__message form__message--error">{{ form.errors.messages.form }}</p>
            {%- endif -%}
            <div class="field">
              <label class="visually-hidden" for="PasswordInput">{{ 'general.password_page.password' | t }}</label>
              <input
                class="field__input"
                type="password"
                id="PasswordInput"
                name="password"
                placeholder="{{ 'general.password_page.password' | t }}"
                autocomplete="current-password"
              >
            </div>
            <button type="submit" class="button button--light button--full">
              {{ 'general.password_page.enter' | t }}
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Something is being distilled. Enter the password if you have one.</p>"
    }
  ]
}
{% endschema %}
