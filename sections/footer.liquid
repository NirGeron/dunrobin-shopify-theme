<footer class="footer {% if section.settings.color_scheme == 'light' %}footer--light{% endif %}">
  <div class="page-width">
    <div class="footer__top">
      {%- for block in section.blocks -%}
        <div class="footer__block" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'brand' -%}
              {%- liquid
                assign footer_logo = block.settings.logo
                if footer_logo == blank
                  if section.settings.color_scheme == 'light'
                    assign footer_logo = settings.logo
                  else
                    assign footer_logo = settings.logo_light
                  endif
                endif
              -%}

              {%- if footer_logo != blank -%}
                <img
                  class="footer__logo"
                  src="{{ footer_logo | image_url: width: 600 }}"
                  alt="{{ shop.name | escape }}"
                  width="{{ footer_logo.width }}"
                  height="{{ footer_logo.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <img
                  class="footer__logo"
                  src="{% if section.settings.color_scheme == 'light' %}{{ 'logo.png' | asset_url }}{% else %}{{ 'logo-white.png' | asset_url }}{% endif %}"
                  alt="{{ shop.name | escape }}"
                  width="1200"
                  height="363"
                  loading="lazy"
                >
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="rte" style="font-size:1.5rem;opacity:.85">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.show_social -%}
                <ul class="footer__social">
                  {%- if settings.social_instagram_link != blank -%}
                    <li><a href="{{ settings.social_instagram_link }}" aria-label="Instagram" rel="noopener" target="_blank">{% render 'icon', name: 'instagram' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_facebook_link != blank -%}
                    <li><a href="{{ settings.social_facebook_link }}" aria-label="Facebook" rel="noopener" target="_blank">{% render 'icon', name: 'facebook' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_twitter_link != blank -%}
                    <li><a href="{{ settings.social_twitter_link }}" aria-label="X" rel="noopener" target="_blank">{% render 'icon', name: 'twitter' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_youtube_link != blank -%}
                    <li><a href="{{ settings.social_youtube_link }}" aria-label="YouTube" rel="noopener" target="_blank">{% render 'icon', name: 'youtube' %}</a></li>
                  {%- endif -%}
                  {%- if settings.social_tiktok_link != blank -%}
                    <li><a href="{{ settings.social_tiktok_link }}" aria-label="TikTok" rel="noopener" target="_blank">{% render 'icon', name: 'tiktok' %}</a></li>
                  {%- endif -%}
                </ul>
              {%- endif -%}

            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <div class="rte" style="font-size:1.5rem;opacity:.85">{{ block.settings.text }}</div>

            {%- when 'policies' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              <ul class="footer__list">
                {%- if shop.privacy_policy != blank -%}
                  <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
                {%- endif -%}
                {%- if shop.terms_of_service != blank -%}
                  <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
                {%- endif -%}
                {%- if shop.shipping_policy != blank -%}
                  <li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>
                {%- endif -%}
                {%- if shop.refund_policy != blank -%}
                  <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                {%- endif -%}
              </ul>

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="footer__block-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte" style="font-size:1.5rem;opacity:.85;margin-bottom:1.6rem">{{ block.settings.text }}</div>
              {%- endif -%}
              {% form 'customer' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="field">
                  <label class="visually-hidden" for="FooterEmail">{{ 'newsletter.label' | t }}</label>
                  <input
                    class="field__input"
                    type="email"
                    name="contact[email]"
                    id="FooterEmail"
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >
                </div>
                <button type="submit" class="button {% unless section.settings.color_scheme == 'light' %}button--light{% endunless %}">
                  {{ 'newsletter.button_label' | t }}
                </button>
                {%- if form.posted_successfully? -%}
                  <p class="form__message form__message--success">{{ 'newsletter.success' | t }}</p>
                {%- endif -%}
                {%- if form.errors -%}
                  <p class="form__message form__message--error">{{ form.errors.messages.email }}</p>
                {%- endif -%}
              {% endform %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <div>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.legal_text != blank %} {{ section.settings.legal_text }}{% endif -%}
      </div>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "shopify-section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "brand", "label": "Brand navy" },
        { "value": "light", "label": "Light" }
      ],
      "default": "brand"
    },
    {
      "type": "textarea",
      "id": "legal_text",
      "label": "Legal line",
      "default": "Please enjoy responsibly. The UK Chief Medical Officers recommend adults do not regularly drink more than 14 units per week."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Authentic craft spirits from the House of Sutherland.</p>"
        },
        { "type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Dunrobin Highland Distillery<br>Dunrobin, Golspie<br>Sutherland KW10 6SF<br>United Kingdom</p>"
        }
      ]
    },
    {
      "type": "policies",
      "name": "Terms and policies",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Terms and Policies" },
        {
          "type": "paragraph",
          "content": "Links to your store's policy pages are added automatically. Set them under Settings > Policies."
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Extra links",
          "info": "Optional. Appended after the policy links."
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "The Dispatch" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Batch releases, tastings at the castle and the occasional recipe.</p>"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      { "type": "menu" },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  },
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
