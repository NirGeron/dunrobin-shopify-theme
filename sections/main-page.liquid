<div class="page-width section-padding" style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="{% if section.settings.narrow %}page-width--narrow{% endif %}" style="margin-inline:auto">
    <div class="section-header section-header--{{ section.settings.alignment }}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="h1">{{ page.title }}</h1>
    </div>
    <div class="rte">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Page content",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "checkbox", "id": "narrow", "label": "Constrain width", "default": true },
    {
      "type": "select",
      "id": "alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ]
}
{% endschema %}
