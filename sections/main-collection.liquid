{%- paginate collection.products by section.settings.products_per_page -%}
  {%- if section.settings.show_banner -%}
    {%- liquid
      assign banner = section.settings.banner_image | default: collection.featured_image
    -%}
    <div class="collection-banner">
      {%- if banner != blank -%}
        <img
          src="{{ banner | image_url: width: 2400 }}"
          srcset="{{ banner | image_url: width: 1200 }} 1200w, {{ banner | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ banner.alt | escape }}"
          width="{{ banner.width }}"
          height="{{ banner.height }}"
          fetchpriority="high"
        >
      {%- else -%}
        <img src="{{ 'pattern-navy.jpg' | asset_url }}" alt="" width="1800" height="588" fetchpriority="high">
      {%- endif -%}
      <div class="collection-banner__overlay"></div>
      <div class="collection-banner__content page-width">
        <h1 class="h1">{{ section.settings.heading | default: collection.title }}</h1>
      </div>
    </div>
  {%- endif -%}

  <div class="page-width section-padding" style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px">
    {%- unless section.settings.show_banner -%}
      <div class="collection-hero">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="h1">{{ section.settings.heading | default: collection.title }}</h1>
      </div>
    {%- endunless -%}

    {%- liquid
      assign blurb = section.settings.description
      if blurb == blank
        assign blurb = collection.description
      endif
    -%}
    {%- if blurb != blank -%}
      <div class="collection-intro rte">{{ blurb }}</div>
    {%- endif -%}

    {%- if collection.products_count > 0 -%}
      <div class="collection-toolbar">
        <span class="collection-toolbar__count">
          {{ 'collections.general.items_count' | t: count: collection.products_count }}
        </span>

        {%- if section.settings.show_sorting and collection.products_count > 1 -%}
          <form method="get" action="{{ collection.url }}" class="select" data-auto-submit>
            <label class="visually-hidden" for="SortBy">{{ 'collections.sorting.title' | t }}</label>
            <select class="select__select" name="sort_by" id="SortBy">
              {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if collection.products.size > 0 -%}
      {%- comment -%}
        A single bottle in a four-column grid looks stranded, so narrow the grid
        when the collection is small.
      {%- endcomment -%}
      {%- liquid
        assign grid_columns = section.settings.columns
        if collection.products_count < grid_columns
          assign grid_columns = collection.products_count
        endif
      -%}
      <ul
        class="product-grid product-grid--{{ grid_columns }} {% if collection.products_count < section.settings.columns %}product-grid--centered{% endif %}"
        role="list"
      >
        {%- for product in collection.products -%}
          <li>{% render 'card-product', product: product, ratio: section.settings.image_ratio %}</li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">&larr;</a>
          {%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">&rarr;</a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <div class="cart-empty">
        <p class="h4">{{ 'collections.general.no_matches' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}

    {%- if section.settings.footer_note != blank -%}
      <p class="collection-note">{{ section.settings.footer_note }}</p>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Falls back to the collection name."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "info": "Falls back to the collection description."
    },
    { "type": "header", "content": "Banner" },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Show a banner behind the heading",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image",
      "info": "Defaults to the collection image, then the brand pattern."
    },
    { "type": "header", "content": "Grid" },
    { "type": "checkbox", "id": "show_sorting", "label": "Show sorting", "default": true },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 3 },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "portrait"
    },
    { "type": "text", "id": "footer_note", "label": "Note below the grid" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ]
}
{% endschema %}
