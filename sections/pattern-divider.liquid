{%- liquid
  assign pattern = section.settings.image | default: settings.pattern_image

  if pattern != blank
    assign pattern_url = pattern | image_url: width: 2400
  elsif section.settings.style == 'navy'
    assign pattern_url = 'pattern-strip-navy.png' | asset_url
  else
    assign pattern_url = 'pattern-strip-white.png' | asset_url
  endif
-%}

{%- comment -%}
  The pattern tiles horizontally at a fixed height, so one motif is always the
  same size and the strip looks identical at every screen width. Stretching a
  single image to 100% width instead would squash it differently per breakpoint.
{%- endcomment -%}
<div
  class="pattern-divider pattern-divider--{{ section.settings.style }}"
  style="height: {{ section.settings.height }}px; background-image: url('{{ pattern_url }}')"
  role="presentation"
></div>

{% schema %}
{
  "name": "Pattern divider",
  "tag": "section",
  "class": "shopify-section--full-bleed",
  "settings": [
    {
      "type": "paragraph",
      "content": "A strip of the Dunrobin arch-and-wave pattern. Use it to separate major areas of a page."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "navy", "label": "White pattern on navy" },
        { "value": "white", "label": "Navy pattern on white" }
      ],
      "default": "navy"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Custom pattern image",
      "info": "Overrides the style above and the pattern set in Theme settings."
    },
    {
      "type": "range",
      "id": "height",
      "min": 40,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Height",
      "default": 120
    }
  ],
  "presets": [{ "name": "Pattern divider" }],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["header", "footer"]
  }
}
{% endschema %}
