<div
  class="scheme--{{ section.settings.color_scheme }} section-padding"
  style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px"
>
  <div class="page-width">
    <div class="page-width--narrow" style="margin-inline:auto">
      <div class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="section-header__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- form 'contact', id: 'ContactForm' -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success">{{ 'contact.form.post_success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
          <input class="field__input" type="text" id="ContactName" name="contact[name]" autocomplete="name">
        </div>

        <div class="field">
          <label class="field__label" for="ContactEmail">{{ 'contact.form.email' | t }}</label>
          <input
            class="field__input"
            type="email"
            id="ContactEmail"
            name="contact[email]"
            autocomplete="email"
            required
          >
        </div>

        <div class="field">
          <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input class="field__input" type="tel" id="ContactPhone" name="contact[phone]" autocomplete="tel">
        </div>

        <div class="field">
          <label class="field__label" for="ContactBody">{{ 'contact.form.message' | t }}</label>
          <textarea class="field__input" id="ContactBody" name="contact[body]" rows="6"></textarea>
        </div>

        <button type="submit" class="button">{{ 'contact.form.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Write to the distillery" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Trade enquiries, private tastings and everything else.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Off-white" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
