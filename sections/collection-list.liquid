<div
  class="scheme--{{ section.settings.color_scheme }} section-padding"
  style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px"
>
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank -%}
      <div class="section-header section-header--center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_collection = block.settings.collection
          assign block_image = block.settings.image | default: block_collection.featured_image
        -%}
        <li {{ block.shopify_attributes }}>
          <div class="card card--center">
            <a
              href="{{ block_collection.url | default: '#' }}"
              class="card__media media media--{{ section.settings.image_ratio }}"
              tabindex="-1"
              aria-hidden="true"
            >
              {%- if block_image != blank -%}
                <img
                  src="{{ block_image | image_url: width: 900 }}"
                  srcset="{{ block_image | image_url: width: 450 }} 450w, {{ block_image | image_url: width: 900 }} 900w"
                  sizes="(min-width: 750px) 33vw, 100vw"
                  alt="{{ block_image.alt | escape }}"
                  width="{{ block_image.width }}"
                  height="{{ block_image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>

            <h3 class="card__title">
              <a href="{{ block_collection.url | default: '#' }}">
                {{ block.settings.heading | default: block_collection.title | default: 'Collection' }}
              </a>
            </h3>

            {%- if block.settings.text != blank -%}
              <div class="card__price">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore" },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 3 },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (3:2)" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "alt", "label": "Off-white" }
      ],
      "default": "default"
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "heading", "label": "Title override" },
        { "type": "text", "id": "text", "label": "Subtitle" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
