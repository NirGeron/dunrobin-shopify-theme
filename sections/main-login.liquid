<div class="page-width section-padding" style="--padding-top:80px;--padding-bottom:96px">
  <div class="page-width--narrow" style="margin-inline:auto;max-width:46rem">
    <div class="section-header section-header--center">
      <h1 class="h2">{{ 'customer.login.title' | t }}</h1>
    </div>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <p class="form__message form__message--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="LoginEmail">{{ 'customer.login.email' | t }}</label>
        <input class="field__input" type="email" id="LoginEmail" name="customer[email]" autocomplete="email" required>
      </div>
      {%- if form.password_needed -%}
        <div class="field">
          <label class="field__label" for="LoginPassword">{{ 'customer.login.password' | t }}</label>
          <input class="field__input" type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password">
        </div>
        <a href="#recover" style="font-size:1.3rem">{{ 'customer.login.forgot_password' | t }}</a>
      {%- endif -%}
      <button type="submit" class="button button--full" style="margin-top:2.4rem">{{ 'customer.login.sign_in' | t }}</button>
    {%- endform -%}

    <p style="text-align:center;margin-top:2.4rem;font-size:1.4rem">
      <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
    </p>

    <div id="recover" style="margin-top:6.4rem;padding-top:4rem;border-top:1px solid var(--border)">
      <h2 class="h4">{{ 'customer.recover_password.title' | t }}</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success">{{ 'customer.recover_password.success' | t }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'customer.login.email' | t }}</label>
          <input class="field__input" type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="button button--secondary">{{ 'customer.recover_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "Login", "tag": "section", "settings": [] }
{% endschema %}
