{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<div class="section-padding" style="--padding-top:{{ section.settings.padding_top }}px;--padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="page-width">
    <div class="product">
      <div class="product__media-wrapper">
        <ul class="product__media-list {% if section.settings.media_layout == 'grid' %}product__media-list--grid{% endif %}" role="list">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <li class="product__media media media--{{ section.settings.media_ratio }}">
                {%- if media.media_type == 'image' -%}
                  <img
                    src="{{ media | image_url: width: 1600 }}"
                    srcset="
                      {{ media | image_url: width: 600 }} 600w,
                      {{ media | image_url: width: 1000 }} 1000w,
                      {{ media | image_url: width: 1600 }} 1600w
                    "
                    sizes="(min-width: 990px) 55vw, 100vw"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}
                  >
                {%- else -%}
                  {{ media | media_tag: image_size: '1600x', autoplay: false, loop: false, controls: true }}
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="product__media media media--{{ section.settings.media_ratio }}">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="product__info {% if section.settings.sticky_info %}product__info--sticky{% endif %}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="eyebrow" {{ block.shopify_attributes }}>
                {{ block.settings.text | default: product.type }}
              </p>

            {%- when 'title' -%}
              <h1 class="product__title h1" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'vendor' -%}
              <p class="card__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>

            {%- when 'price' -%}
              <div class="product__price" id="ProductPrice" {{ block.shopify_attributes }}>
                {% render 'price', variant: current_variant %}
              </div>

            {%- when 'specs' -%}
              <div class="spec-bar" style="margin-bottom:2.4rem" {{ block.shopify_attributes }}>
                {%- if block.settings.label_1 != blank -%}
                  <div class="spec-bar__item">
                    <span class="spec-bar__label">{{ block.settings.label_1 }}</span>
                    <span class="spec-bar__value">{{ block.settings.value_1 }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.label_2 != blank -%}
                  <div class="spec-bar__item">
                    <span class="spec-bar__label">{{ block.settings.label_2 }}</span>
                    <span class="spec-bar__value">{{ block.settings.value_2 }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.label_3 != blank -%}
                  <div class="spec-bar__item">
                    <span class="spec-bar__label">{{ block.settings.label_3 }}</span>
                    <span class="spec-bar__value">{{ block.settings.value_3 }}</span>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'description' -%}
              <div class="product__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>

            {%- when 'text' -%}
              <div class="rte" style="margin-bottom:2.4rem" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset>
                      <legend class="variant-picker__legend">{{ option.name }}</legend>
                      <div class="variant-picker__options">
                        {%- for value in option.values -%}
                          <input
                            class="variant-picker__input"
                            type="radio"
                            id="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                            name="option-{{ forloop.parentloop.index0 }}"
                            value="{{ value | escape }}"
                            data-option-position="{{ option.position }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label
                            class="variant-picker__label"
                            for="Option-{{ section.id }}-{{ forloop.parentloop.index0 }}-{{ forloop.index0 }}"
                          >
                            {{ value }}
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}

                  <script type="application/json" data-variant-data>
                    {{ product.variants | json }}
                  </script>
                </div>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div {{ block.shopify_attributes }}>
                <span class="field__label" style="display:block;margin-bottom:.8rem">
                  {{ 'products.product.quantity.label' | t }}
                </span>
                <div class="product-form__quantity">
                  <button
                    type="button"
                    class="quantity__button"
                    data-product-quantity-delta="-1"
                    aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}"
                  >
                    &minus;
                  </button>
                  <input
                    class="quantity__input"
                    type="number"
                    name="quantity"
                    form="ProductForm-{{ section.id }}"
                    min="1"
                    value="1"
                    data-product-quantity
                    aria-label="{{ 'products.product.quantity.label' | t }}"
                  >
                  <button
                    type="button"
                    class="quantity__button"
                    data-product-quantity-delta="1"
                    aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}"
                  >
                    +
                  </button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product-form__buttons" {{ block.shopify_attributes }}>
                {%- form 'product',
                  product,
                  id: 'ProductForm',
                  class: 'product-form',
                  novalidate: 'novalidate',
                  data-product-form: ''
                -%}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ current_variant.id }}"
                    data-variant-id
                    {% unless current_variant.available %}disabled{% endunless %}
                  >

                  <button
                    type="submit"
                    name="add"
                    class="button button--full"
                    data-add-to-cart
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-add-to-cart-text>
                      {%- if current_variant == null -%}
                        {{ 'products.product.unavailable' | t }}
                      {%- elsif current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                  </button>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </div>

            {%- when 'shipping_note' -%}
              <p
                style="display:flex;align-items:center;justify-content:center;gap:.8rem;font-size:1.2rem;letter-spacing:var(--label-tracking);text-transform:uppercase;color:var(--text-muted)"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.text }}
              </p>

            {%- when 'accordion' -%}
              <div class="accordion" style="margin-top:3.2rem" {{ block.shopify_attributes }}>
                <details class="accordion__item" {% if block.settings.open %}open{% endif %}>
                  <summary class="accordion__summary">
                    {{ block.settings.heading }}
                    <span class="accordion__icon"></span>
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                  </div>
                </details>
              </div>

            {%- when 'detail_rows' -%}
              <div style="margin-top:3.2rem;padding-top:2.4rem;border-top:1px solid var(--border)" {{ block.shopify_attributes }}>
                {%- for i in (1..4) -%}
                  {%- liquid
                    case i
                      when 1
                        assign row_label = block.settings.label_1
                        assign row_value = block.settings.value_1
                      when 2
                        assign row_label = block.settings.label_2
                        assign row_value = block.settings.value_2
                      when 3
                        assign row_label = block.settings.label_3
                        assign row_value = block.settings.value_3
                      when 4
                        assign row_label = block.settings.label_4
                        assign row_value = block.settings.value_4
                    endcase
                  -%}
                  {%- if row_label != blank -%}
                    <div style="display:flex;justify-content:space-between;gap:1.6rem;padding:1rem 0">
                      <span class="field__label">{{ row_label }}</span>
                      <span style="font-size:1.4rem">{{ row_value }}</span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

            {%- when 'share' -%}
              <div style="margin-top:2.4rem" {{ block.shopify_attributes }}>
                <a class="link-arrow" href="{{ shop.url }}{{ product.url }}" data-share-link>
                  {{ 'general.share' | t }}
                </a>
              </div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "media_layout",
      "label": "Media layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "grid", "label": "Grid (first image full width)" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media shape",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait (4:5)" }
      ],
      "default": "adapt"
    },
    { "type": "checkbox", "id": "sticky_info", "label": "Stick product details on scroll", "default": true },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow label",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "Falls back to the product type when empty."
        }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "specs",
      "name": "Specification bar",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_1", "label": "Label 1", "default": "ABV" },
        { "type": "text", "id": "value_1", "label": "Value 1", "default": "45%" },
        { "type": "text", "id": "label_2", "label": "Label 2", "default": "Volume" },
        { "type": "text", "id": "value_2", "label": "Value 2", "default": "70cl" },
        { "type": "text", "id": "label_3", "label": "Label 3", "default": "Origin" },
        { "type": "text", "id": "value_3", "label": "Value 3", "default": "Golspie" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "text",
      "name": "Custom text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    {
      "type": "shipping_note",
      "name": "Shipping note",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Complimentary UK shipping on orders over £100"
        }
      ]
    },
    {
      "type": "detail_rows",
      "name": "Detail rows",
      "settings": [
        { "type": "text", "id": "label_1", "label": "Label 1", "default": "Batch no." },
        { "type": "text", "id": "value_1", "label": "Value 1", "default": "001" },
        { "type": "text", "id": "label_2", "label": "Label 2", "default": "Distillation" },
        { "type": "text", "id": "value_2", "label": "Value 2", "default": "Traditional pot still" },
        { "type": "text", "id": "label_3", "label": "Label 3", "default": "Units per bottle" },
        { "type": "text", "id": "value_3", "label": "Value 3", "default": "31.5 UK units" },
        { "type": "text", "id": "label_4", "label": "Label 4" },
        { "type": "text", "id": "value_4", "label": "Value 4" }
      ]
    },
    {
      "type": "accordion",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tasting notes" },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Scottish juniper, rhubarb, heather, Scots pine resin, bramble leaf, blaeberry, crab apple and toasted oats.</p>"
        },
        { "type": "page", "id": "page", "label": "Or pull content from a page" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    { "type": "share", "name": "Share link", "limit": 1 },
    { "type": "@app" }
  ]
}
{% endschema %}
