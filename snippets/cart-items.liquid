{%- if cart.item_count == 0 -%}
  <div class="cart-empty">
    <p class="h4">{{ 'sections.cart.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">
      {{ 'general.continue_shopping' | t }}
    </a>
  </div>
{%- else -%}
  {%- liquid
    assign is_page = false
    if context == 'page'
      assign is_page = true
    endif
  -%}

  <div class="cart-items {% if is_page %}cart-items--page{% endif %}">
    {%- if is_page -%}
      {%- comment -%}
        Column headings so the quantity and total columns are labelled rather
        than left to be inferred. Hidden on mobile, where the row stacks.
      {%- endcomment -%}
      <div class="cart-items__header" aria-hidden="true">
        <span>{{ 'sections.cart.headings.product' | t }}</span>
        <span>{{ 'sections.cart.headings.quantity' | t }}</span>
        <span>{{ 'sections.cart.headings.total' | t }}</span>
      </div>
    {%- endif -%}

    {%- for item in cart.items -%}
      <div class="cart-item" data-cart-item data-line="{{ forloop.index }}">
        <a href="{{ item.url }}" class="cart-item__image" tabindex="-1" aria-hidden="true">
          {%- if item.image -%}
            <img
              src="{{ item.image | image_url: width: 200 }}"
              alt="{{ item.image.alt | escape }}"
              width="80"
              height="{{ 80 | divided_by: item.image.aspect_ratio | round }}"
              loading="lazy"
            >
          {%- endif -%}
        </a>

        <div class="cart-item__details">
          <div class="cart-item__title">
            <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
          </div>

          {%- unless item.product.has_only_default_variant -%}
            <div class="cart-item__variant">{{ item.variant.title }}</div>
          {%- endunless -%}

          {%- if item.selling_plan_allocation -%}
            <div class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</div>
          {%- endif -%}

          {%- comment -%}
            Properties whose name begins with an underscore are private and are
            not shown. Liquid has no startswith operator, so slice the first
            character off instead.
          {%- endcomment -%}
          {%- for property in item.properties -%}
            {%- assign property_prefix = property.first | slice: 0 -%}
            {%- unless property.last == blank or property_prefix == '_' -%}
              <div class="cart-item__variant">{{ property.first }}: {{ property.last }}</div>
            {%- endunless -%}
          {%- endfor -%}

          {%- if item.line_level_discount_allocations.size > 0 -%}
            {%- for allocation in item.line_level_discount_allocations -%}
              <div class="cart-item__variant">
                {{ allocation.discount_application.title }} (&minus;{{ allocation.amount | money }})
              </div>
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} What one of them costs, so the line total adds up visibly. {%- endcomment -%}
          <div class="cart-item__unit">{{ item.original_price | money }} {{ 'sections.cart.each' | t }}</div>

          <div class="cart-item__footer">
            <div class="product-form__quantity" style="margin:0">
              <button
                type="button"
                class="quantity__button"
                data-quantity-change="{{ forloop.index }}"
                data-quantity-delta="-1"
                aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
              >
                &minus;
              </button>
              <input
                class="quantity__input"
                type="number"
                min="0"
                value="{{ item.quantity }}"
                data-quantity-input="{{ forloop.index }}"
                aria-label="{{ 'products.product.quantity.label' | t }}"
              >
              <button
                type="button"
                class="quantity__button"
                data-quantity-change="{{ forloop.index }}"
                data-quantity-delta="1"
                aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
              >
                +
              </button>
            </div>

            <button
              type="button"
              class="cart-item__remove"
              data-cart-remove="{{ forloop.index }}"
              aria-label="{{ 'sections.cart.remove_item' | t: product: item.product.title | escape }}"
            >
              {% render 'icon', name: 'trash' %}
              <span class="cart-item__remove-label">{{ 'sections.cart.remove' | t }}</span>
            </button>
          </div>
        </div>

        <div class="cart-item__price">
          {%- if item.original_line_price != item.final_line_price -%}
            <s style="opacity:.6">{{ item.original_line_price | money }}</s>
            {{ item.final_line_price | money }}
          {%- else -%}
            {{ item.original_line_price | money }}
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}
