{%- liquid
  assign gate_bg = settings.age_gate_background | default: settings.pattern_image
  assign gate_logo = settings.logo
-%}

<div
  class="age-gate"
  id="AgeGate"
  role="dialog"
  aria-modal="true"
  aria-labelledby="AgeGateHeading"
  data-frequency="{{ settings.age_gate_frequency | default: 'session' }}"
  hidden
>
  <div class="age-gate__backdrop" aria-hidden="true">
    {%- if gate_bg != blank -%}
      <img
        src="{{ gate_bg | image_url: width: 2400 }}"
        srcset="{{ gate_bg | image_url: width: 1200 }} 1200w, {{ gate_bg | image_url: width: 2400 }} 2400w"
        sizes="100vw"
        alt=""
        width="{{ gate_bg.width }}"
        height="{{ gate_bg.height }}"
      >
    {%- else -%}
      <img src="{{ 'pattern-white.jpg' | asset_url }}" alt="" width="1800" height="588">
    {%- endif -%}
  </div>

  <div class="age-gate__panel" data-age-gate-ask>
    {%- if gate_logo != blank -%}
      <img
        class="age-gate__logo"
        src="{{ gate_logo | image_url: width: 600 }}"
        alt="{{ shop.name | escape }}"
        width="600"
        height="{{ 600 | divided_by: gate_logo.aspect_ratio | round }}"
      >
    {%- else -%}
      <img class="age-gate__logo" src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="600" height="182">
    {%- endif -%}

    <h2 class="age-gate__heading h3" id="AgeGateHeading">{{ settings.age_gate_heading }}</h2>

    {%- if settings.age_gate_text != blank -%}
      <div class="age-gate__text rte">{{ settings.age_gate_text }}</div>
    {%- endif -%}

    <div class="age-gate__buttons">
      <button type="button" class="button" data-age-gate-accept>
        {{ settings.age_gate_accept }}
      </button>
      {%- comment -%}
        A link, so it still works without JS. With JS it shows the farewell
        panel first and follows the same href once the delay is up.
      {%- endcomment -%}
      <a
        class="button button--secondary"
        href="{{ settings.age_gate_decline_url | default: 'https://www.google.com/' }}"
        rel="noopener"
        data-age-gate-decline
      >
        {{ settings.age_gate_decline }}
      </a>
    </div>

    {%- if settings.age_gate_note != blank -%}
      <p class="age-gate__note">{{ settings.age_gate_note }}</p>
    {%- endif -%}
  </div>

  <div
    class="age-gate__panel age-gate__panel--farewell"
    data-age-gate-farewell
    data-delay="{{ settings.age_gate_decline_delay | default: 5 }}"
    hidden
  >
    <h2 class="age-gate__heading h3">
      {{ settings.age_gate_decline_heading | default: 'We are sorry' }}
    </h2>

    {%- if settings.age_gate_decline_text != blank -%}
      <div class="age-gate__text rte">{{ settings.age_gate_decline_text }}</div>
    {%- endif -%}

    {%- comment -%} __COUNT__ is swapped for the remaining seconds each tick. {%- endcomment -%}
    <p
      class="age-gate__note"
      data-age-gate-countdown
      data-singular="{{ 'general.age_gate.redirecting.one' | t: count: '__COUNT__' | escape }}"
      data-plural="{{ 'general.age_gate.redirecting.other' | t: count: '__COUNT__' | escape }}"
      role="status"
      aria-live="polite"
    ></p>
  </div>
</div>
