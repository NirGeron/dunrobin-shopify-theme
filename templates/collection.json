    "rich_text_eicGFj": {
      "type": "rich-text",
      "blocks": {
        "eyebrow_np9FJi": {
          "type": "eyebrow",
          "settings": {
            "text": "How to enjoy Dunrobin Highland Gin"
          }
        },
        "heading_dmPmpA": {
          "type": "heading",
          "settings": {
            "text": "The Perfect Serve",
            "size": "h1"
          }
        },
        "text_XbMLtd": {
          "type": "text",
          "settings": {
            "text": "<p>Dunrobin Gin can be enjoyed in a number of ways, allowing its distinctive botanicals and earthy, floral flavours to shine.</p><p>For a simple serve, enjoy Dunrobin Gin neat over ice, allowing the flavours to gradually open up.</p><p>For a classic gin and tonic, pour over plenty of ice, top with a premium tonic water and garnish with a fresh slice of lemon, gently squeezed before adding to the glass.</p>"
          }
        }
      },
