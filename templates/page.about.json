    "story": {
      "type": "image-with-text",
      "blocks": {
        "eyebrow": {
          "type": "eyebrow",
          "settings": {
            "text": "The people"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "A family distillery in Golspie",
            "size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Lizzie and Boban live with their family in Golspie. They have treasured every step of the journey in creating Dunrobin Gin, from the recipe work to the day the still arrived to opening the doors of the pop up shop at the castle.</p><p>Creating something of their own that represents their home has been a delight. Their vision is to now move on to starting their own whisky.</p>"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "heading",
        "text"
      ],
      "settings": {
        "builtin_image": "team",
