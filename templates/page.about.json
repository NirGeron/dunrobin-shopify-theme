        "layout": "image_first",
        "wide_media": false,
        "color_scheme": "default",
        "padding_top": 32,
        "padding_bottom": 64
      }
    },
    "botanicals": {
      "type": "image-with-text",
      "blocks": {
        "eyebrow": {
          "type": "eyebrow",
          "settings": {
            "text": "The botanicals"
          }
        },
        "heading": {
          "type": "heading",
          "settings": {
            "text": "Gathered where forest and sea meet",
            "size": "h2"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Our gin is shaped to evoke the experience of forest and garden. Its botanicals are juniper, lemon, coriander, clove, blackcurrant, angelica root and rose-scented pelargonium leaf, with spring water from the Big Burn.</p><p>We worked with Susanne Masters and Dunrobin Castle’s head gardener, Ian Crisp, on the botanical research behind the recipe.</p>"
          }
        },
        "button": {
          "type": "button",
